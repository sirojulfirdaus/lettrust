# Contoh konfigurasi Lettrust (SA §14.2). Salin otomatis ke .env oleh `python scripts/dev.py up`.
# Jangan menaruh nilai rahasia nyata di berkas ini. .env tidak boleh di-commit.

# Umum (backend, ai-service)
APP_ENV=local
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=5242880

# Backend
DATABASE_URL=sqlite:////data/lettrust.db
# Diisi otomatis oleh dev.py (secrets.token_urlsafe(32)) saat .env pertama kali dibuat.
JWT_SECRET=
JWT_EXPIRES_MINUTES=480
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REGISTRY_RPC_URL=http://chain:8545
REGISTRY_DEPLOYMENT_FILE=/shared/deployments/local.json
REGISTRY_CONTRACT_ADDRESS=
# DEV ONLY – public test key: akun #0 mnemonic bawaan Anvil ("test test ... junk"). Tidak bernilai di jaringan publik.
REGISTRY_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
REGISTRY_RPC_TIMEOUT_SECONDS=5
REGISTRY_TX_RECEIPT_TIMEOUT_SECONDS=20
AI_SERVICE_URL=http://ai-service:8001
# Diisi otomatis oleh dev.py.
INTERNAL_API_TOKEN=
AI_EXTRACTION_TIMEOUT_SECONDS=60
AI_ANALYSIS_TIMEOUT_SECONDS=50
# Diisi otomatis oleh dev.py. Dipakai seed backend dan server portal (LETTRUST_PARTNER_TOKEN).
PARTNER_TOKEN=
PARTNER_RATE_LIMIT_PER_MINUTE=60
# Password akun seed, hanya untuk environment lokal dengan data sintetis.
SEED_ADMIN_PASSWORD=Admin#Demo2026
SEED_HR_PASSWORD=Hr#Demo2026

# ai-service
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
# Diisi manual oleh setiap anggota dengan kunci akun masing-masing. Kosong = llm unconfigured.
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_REASONING_EFFORT=
LLM_REQUEST_TIMEOUT_SECONDS=40
LLM_MAX_OUTPUT_TOKENS=900
PROMPT_VERSION=v1
AI_MAX_PAGES=5
AI_MAX_CHARS=12000
OCR_MIN_CHARS_PER_PAGE=25
OCR_DPI=300
OCR_PAGE_TIMEOUT_SECONDS=20
EVIDENCE_FUZZY_THRESHOLD=90

# issuer-console (build arg)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# partner-portal (server). LETTRUST_PARTNER_TOKEN diambil dari PARTNER_TOKEN oleh compose.yaml.
LETTRUST_API_BASE_URL=http://backend:8000
PORTAL_UPSTREAM_TIMEOUT_MS=120000

# Override port host (opsional) bila port default bentrok dengan aplikasi lain. Port internal antar-container tetap.
# Bila CONSOLE_HOST_PORT diubah, sesuaikan CORS_ALLOWED_ORIGINS; bila BACKEND_HOST_PORT diubah, sesuaikan NEXT_PUBLIC_API_BASE_URL lalu build ulang.
# CONSOLE_HOST_PORT=3000
# PORTAL_HOST_PORT=3001
# BACKEND_HOST_PORT=8000
# AI_SERVICE_HOST_PORT=8001
# CHAIN_HOST_PORT=8545
